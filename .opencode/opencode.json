{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "*": "ask",
        "bash": {
            "*": "ask",
            "find *": "allow"
        },
        "edit": {
            "*": "allow",
            "*/opencode.json": "deny",
            "/wordpress/*": "deny"
        },
        "question": "allow",
        "read": {
            "*": "allow",
            "*.env": "deny",
            "*.env.*": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "webfetch": "ask",
        "websearch": "allow"
    },
    "watcher": {
        "ignore": [
            "node_modules/**",
            "dist/**"
        ]
    }
}