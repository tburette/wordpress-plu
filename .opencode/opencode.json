{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "*": "ask",
        "external_directory": "ask",
        "read": {
            "*": "allow",
            "*.env": "deny",
            "*.env.*": "deny",
            "*.env.example": "allow"
        },
        "edit": {
            "*": "allow",
            "**/opencode.json": "deny"
        },
        "bash": {
            "*": "ask",
            "cd *": "allow",
            "find *": "allow",
            "find * -delete*": "deny",
            "find * -exec*": "deny",
            "find * -ok*": "deny",
            "find * -fprint*": "deny",
            "find * -fls *": "deny",
            "rg *": "allow",
            "cat *": "allow",
            "head *": "allow",
            "tail *": "allow",
            "echo *": "allow",
            "ls *": "allow",
            "wp-env status": "allow",
            "git status *": "allow",
            "git log *": "allow",
            "git diff *": "allow",
            "git show *": "allow",
            "git ls-files *": "allow",
            "git add *": "allow",
            "git commit *": "allow",
            "git commit *--amend": "ask",
        },
        "glob": "allow",
        "grep": "allow",
        "webfetch": "ask",
        "websearch": "allow",
        "web-inspector": "allow",
        "wordpress-inspector": "allow",
        "todowrite": "allow",
        "task": "allow",
        "skill": "allow",
        "question": "allow"
    },
    "watcher": {
        "ignore": [
            "node_modules/**"
        ]
    }
}